NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Contact form (https://resend.com). Without it the form opens the visitor's mail app.
RESEND_API_KEY=
# Optional: CONTACT_TO=you@example.com  CONTACT_FROM="Portfolio <hello@your-domain>"
# Optional: raises the GitHub API rate limit for the activity block.
GITHUB_TOKEN=
# "Ask Nikhil" chat. Free: set GEMINI_API_KEY (Google AI Studio). Paid: ANTHROPIC_API_KEY (Claude) wins if both are set.
# With neither, the chat gives instant answers from the site content (no AI).
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
ANTHROPIC_API_KEY=
